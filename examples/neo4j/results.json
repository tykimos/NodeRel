      "cypher": "MATCH p=(s:NodeRelItem {noderel_id:$id})-[:ACTED_IN*1..4]-(n:NodeRelItem) WHERE n<>s RETURN n.noderel_id AS id,min(length(p)) AS depth",
      "params": {
        "id": "movies:Person:Keanu%20Reeves"
      },
      "sql": "WITH RECURSIVE edge(src,dst) AS (SELECT from_id src,to_id dst FROM links WHERE scope=:scope AND type IN (:t0) UNION SELECT to_id src,from_id dst FROM links WHERE scope=:scope AND type IN (:t0)), walk(id,depth) AS (\n   SELECT id,0 FROM items WHERE id=:id AND scope=:scope\n   UNION\n   SELECT e.dst,w.depth+1 FROM walk w JOIN edge e ON e.src=w.id\n   JOIN items target ON target.id=e.dst AND target.scope=:scope\n   WHERE w.depth<:maxDepth\n  ) SELECT i.id,i.title,i.kind,min(w.depth) AS depth\n  FROM walk w JOIN items i ON i.id=w.id\n  WHERE w.id<>:id GROUP BY i.id ORDER BY depth,i.id"
    },
